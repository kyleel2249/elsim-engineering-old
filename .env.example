NEXT_PUBLIC_SITE_URL=https://elsimengineeringlimited.com

# Optional: wire up the quotation API route to a real inbox once ELSIM
# provides a verified address. Leaving these unset keeps the route in
# "logged locally" dev mode (see app/api/quotation/route.ts).
QUOTATION_NOTIFY_EMAIL=
RESEND_API_KEY=

# Optional: persist quotations to Supabase instead of the local JSON
# fallback store (lib/server/quotation-store.ts).
SUPABASE_URL=
SUPABASE_ANON_KEY=
